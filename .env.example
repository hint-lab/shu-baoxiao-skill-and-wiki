REIMBURSEMENT_IMAP_HOST=imap.example.com
REIMBURSEMENT_IMAP_PORT=993
REIMBURSEMENT_IMAP_USERNAME=teacher@example.edu
REIMBURSEMENT_IMAP_PASSWORD=app-password-or-token
REIMBURSEMENT_IMAP_MAILBOX=INBOX
REIMBURSEMENT_IMAP_MARK_SEEN=false

# Optional Doubao/Volcengine Ark extraction.
# Leave disabled for offline local rules only.
DOUBAO_EXTRACT_ENABLED=false
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TIMEOUT=30
