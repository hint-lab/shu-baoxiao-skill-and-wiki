{
  "id": "mock_school",
  "name": "本地模拟上海大学财务系统",
  "start_url": "http://127.0.0.1:8765/mock-school",
  "manual_login": {
    "required": true,
    "complete_click_test_id": "manual-login-done"
  },
  "form_ready": {
    "test_id": "reimbursement-form",
    "timeout_ms": 10000
  },
  "fields": {
    "entry": {
      "test_id": "school-entry",
      "kind": "select",
      "value_path": "school_system.recommended_entry"
    },
    "reason": {
      "test_id": "reason",
      "kind": "textarea",
      "value_path": "draft_fields.reason"
    }
  },
  "lists": {
    "attachments": {
      "test_id": "attachment-list"
    },
    "pause_points": {
      "test_id": "pause-list"
    }
  },
  "status_message": {
    "test_id": "stop-message",
    "text": "Agent 已完成可自动填写内容，已在提交预审前停止，等待老师确认。"
  },
  "submission_guard": {
    "test_id": "submit-precheck",
    "must_be_disabled": true
  }
}
