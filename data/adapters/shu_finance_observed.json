{
  "id": "shu_finance_observed",
  "name": "上海大学财务系统日常报销观察稿",
  "start_url": "https://znbx.shu.edu.cn:8000/BaseDataMobileWeb/#/Login/ShuAuth",
  "target_after_login_url": "https://znbx.shu.edu.cn:8000/BaseDataMobileWeb/#/Frame/Iframe/%23%2FLogin%2FCMSLogin%3FreturnUrl%3Dhttps%253A%252F%252Fznbx.shu.edu.cn%253A8000%252FClaimsPhone%252F%2523%252Fdaily%252Fstep1",
  "observed_at": "2026-06-30",
  "manual_login": {
    "required": true,
    "note": "统一身份认证、滑块、验证码、二次确认必须由本人完成。Agent 只在用户完成登录并到达日常报销单后继续。"
  },
  "form_ready": {
    "text": "日常报销单",
    "timeout_ms": 120000
  },
  "observed_steps": [
    {
      "step": "daily_step1",
      "title": "日常报销单",
      "sections": [
        "报销人信息",
        "经费预算信息",
        "内转订单信息",
        "票据影像（需识别）",
        "附件上传（需识别）"
      ],
      "fields": [
        {
          "name": "报销人",
          "kind": "readonly_text",
          "source": "school_account",
          "agent_action": "read_only"
        },
        {
          "name": "所属部门",
          "kind": "readonly_text",
          "source": "school_account",
          "agent_action": "read_only"
        },
        {
          "name": "职务职称",
          "kind": "readonly_text",
          "source": "school_account",
          "agent_action": "read_only"
        },
        {
          "name": "联系方式（手机号）",
          "kind": "input",
          "source": "school_account",
          "agent_action": "read_only"
        },
        {
          "name": "报销事由",
          "kind": "textarea",
          "limit": 30,
          "placeholder": "某某人报销某某事项某某费用",
          "value_path": "draft_fields.reason_short",
          "agent_action": "fill_after_user_confirmation"
        },
        {
          "name": "情况说明",
          "kind": "textarea",
          "limit": 60,
          "placeholder": "请输入备注",
          "value_path": "draft_fields.note_short",
          "agent_action": "fill_after_user_confirmation"
        },
        {
          "name": "请选择预算项目",
          "kind": "modal_picker",
          "agent_action": "manual_required",
          "pause_reason": "经费预算项目必须由本人确认。"
        },
        {
          "name": "请选择内转订单",
          "kind": "modal_picker",
          "agent_action": "manual_optional",
          "pause_reason": "如涉及内转订单，必须由本人确认。"
        },
        {
          "name": "请选择票据",
          "kind": "upload",
          "value_path": "upload_documents",
          "agent_action": "upload_after_user_confirmation"
        },
        {
          "name": "请选择附件",
          "kind": "upload",
          "value_path": "upload_documents",
          "agent_action": "upload_after_user_confirmation"
        }
      ],
      "buttons": [
        {
          "name": "保存草稿",
          "agent_action": "allowed_after_user_confirmation"
        },
        {
          "name": "下一步",
          "agent_action": "manual_required",
          "pause_reason": "进入下一步前需要本人确认预算项目、票据和附件。"
        }
      ]
    }
  ],
  "submission_guard": {
    "must_pause_before_click": true,
    "pause_points": [
      "选择经费预算项目",
      "确认票据影像",
      "确认附件",
      "保存草稿",
      "下一步",
      "提交预审",
      "提交审批",
      "任何真实性、合规性或承诺类勾选"
    ]
  }
}
