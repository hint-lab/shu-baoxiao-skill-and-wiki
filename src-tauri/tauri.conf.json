{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上海大学自助报销Agent",
  "version": "0.1.0",
  "identifier": "cn.hintlab.shu-reimbursement-agent",
  "build": {
    "beforeDevCommand": "python3 tools/run_local_server.py",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": [
      {
        "url": "http://127.0.0.1:8765",
        "title": "上海大学自助报销Agent",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
